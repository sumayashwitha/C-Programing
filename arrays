3. sum of digits in an array
   #include<stdio.h>
   int main(){
   int i,n,x, sum=0;
   printf("enter the size of n: \n");
   scanf("%d",&n);
   printf("enter the elements:\n");
   for(i=0; i<n;i++){
         scanf("%d", &x);
         sum=sum+x;
   }
   printf("the value of sum is %d", sum);
   return 0;
}

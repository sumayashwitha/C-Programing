1. \\sum of even or odd numbers in an array
#include<stdio.h>
int main(){
int n, i, x;
int evensum=0, oddsum=0;
printf("enter the size of n:\n");
scanf("%d", &n);
printf("enter the elements:");
for(i=0;i<n;i++){
    scanf("%d", &x);
    if(x%2==0){
       evensum+=x;
    }else{
      oddsum+=x;
    }
}
    printf("the sum of even numbers:%d\n", evensum);
    printf("the sum of odd numbers:%d\n", oddsum);
    return 0;
    }



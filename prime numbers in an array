#include <stdio.h>


int isPrime(int x) {
    int i;

    if (x <= 1) {
        return 0;        // 0 and 1 are not prime
    }

   
    for (i = 2; i * i <= x; i++) {
        if (x % i == 0) {
            return 0;   
        }
    }

    return 1;            
}
int main() {
    int n;               
    int i;               
    int num;             
    int sum = 0;       

    printf("Enter number of elements: ");
    scanf("%d", &n);     // read n

    printf("Enter %d numbers:\n", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &num);       // read one number

        if (isPrime(num)) {     // check if it's prime
            printf("%d is prime\n", num);
            sum = sum + num;    // add prime to sum
        }
    }

    printf("Sum of prime numbers = %d\n", sum);
    return 0;
}
